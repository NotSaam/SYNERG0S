# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local al repositorio.

# Postgres (Supabase, plan gratuito). En Vercel las inyecta la integración de Supabase del Marketplace.
# Conexión de la app: pooler en modo transacción (puerto 6543).
POSTGRES_URL=
# Conexión de sesión (puerto 5432): la usa `npm run db:push` para crear las tablas.
POSTGRES_URL_NON_POOLING=
# Opcional: solo se lee si falta POSTGRES_URL (un Postgres que no venga de esa integración).
# DATABASE_URL=

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres): openssl rand -hex 32
AUTH_SECRET=

# Usuario de prueba que crea `npm run db:seed`
DEMO_USER=demo
DEMO_PASSWORD=

# Proveedor de IA: cualquier API compatible con OpenAI con plan gratuito.
#   Groq      https://api.groq.com/openai/v1
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai
#   Mistral   https://api.mistral.ai/v1
#   Cerebras  https://api.cerebras.ai/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Admite varios modelos separados por comas: el primero es el principal y el resto, reserva
# si está saturado o sin cuota. Cada uno puede llevar «@nivel» con su esfuerzo de razonamiento.
# Ejemplo con Gemini:
#   LLM_MODEL=gemini-3.6-flash@none,gemini-3.5-flash@none,gemini-3.5-flash-lite@minimal
LLM_MODEL=openai/gpt-oss-120b
# Opcional: esfuerzo de razonamiento por defecto para los modelos sin «@nivel»
# LLM_REASONING_EFFORT=low
# "true" si el proveedor admite response_format json_schema
LLM_STRUCTURED_OUTPUTS=false

# Opcional: segundo proveedor por si el primero está caído (mismas tres variables)
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_MODEL=

# Opcional: tope de peticiones al día para proteger la cuota gratuita
MAX_RUNS_PER_DAY=40
